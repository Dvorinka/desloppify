# Example consumer workflow — copy into your repo as
# .github/workflows/desloppify-pr-review.yml
#
# Mechanical PR review, no LLM: annotations on changed lines, strict-score
# delta vs the PR base, optional regression gate.
name: desloppify
on:
  pull_request:

permissions:
  contents: read
  pull-requests: write # for the summary comment; drop if comment: "false"

jobs:
  diff-review:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0 # needed for base...HEAD ranges

      - uses: Dvorinka/desloppify@main
        with:
          lang: "" # auto-detect
          path: "."
          # base: "" # defaults to the PR base sha
          comment: "true"
          # Gate: fail when the strict score drops more than 0.5 points.
          fail-on-regression: "0.5"
